<?xml version="1.0"?>
<ruleset name="Oli Duplicate Post">
	<description>WordPress-Extra coding standards for Oli Duplicate Post.</description>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/artifacts/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="s"/>
	<arg name="parallel" value="4"/>

	<rule ref="WordPress-Extra"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="oli-duplicate-post"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="oli_dp"/>
				<element value="Oli_DP"/>
				<element value="OLI_DP"/>
				<element value="oliDp"/>
			</property>
		</properties>
	</rule>
</ruleset>
